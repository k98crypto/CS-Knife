# 使用 LF 换行符（跨平台统一）
* text=auto eol=lf

# Windows 批处理文件使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# JavaScript 使用 LF
*.js text eol=lf

# Python 使用 LF
*.py text eol=lf
*.pyw text eol=lf

# Shell 脚本使用 LF
*.sh text eol=lf

# 确保某些文件是二进制
*.ico binary
*.jpg binary
*.png binary
*.exe binary